# =================================================================
# ProERP MegaMart Production & Sandbox Environment Configuration
# =================================================================

# ----------------- PostgreSQL Database -----------------
POSTGRES_DB=megamartdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/megamartdb

# ----------------- Application Security -----------------
# Generate a secure 256-bit hexadecimal string for production
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Set to true ONLY if you want demo mock stores & products. Keep false for clean production!
SEED_SAMPLE_DATA=false

# ----------------- Razorpay Test / Live Keys -----------------
# Free Test Dashboard: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE

# ----------------- Stripe Test / Live Keys -----------------
# Free Test Dashboard: https://dashboard.stripe.com
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
