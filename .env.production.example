# ================================================================
# MegaMart Production Environment Variables — EC2 Server
# Copy this to /opt/megamart/.env on your EC2 instance
# NEVER commit real values to Git
# ================================================================

# ── AWS ──────────────────────────────────────────────────────────
ECR_REGISTRY=YOUR_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com
AWS_REGION=ap-south-1

# ── Database (Amazon RDS PostgreSQL) ─────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT.rds.amazonaws.com:5432/megamartdb
SPRING_DATASOURCE_USERNAME=megamartuser
SPRING_DATASOURCE_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── JWT Security ─────────────────────────────────────────────────
# Generate: openssl rand -hex 64
APP_JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# ── CORS (your domain or EC2 public IP) ──────────────────────────
CORS_ALLOWED_ORIGINS=http://YOUR-EC2-IP,https://yourdomain.com

# ── Payment Gateways ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXX
