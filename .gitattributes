# ============================================================
# MegaMart — .gitattributes
# Normalize line endings: Unix (LF) in repo, auto on checkout
# ============================================================

# Default: normalize all text files to LF in the repo
* text=auto eol=lf

# Force LF for source code
*.java        text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.properties  text eol=lf
*.md          text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.sh          text eol=lf
*.sql         text eol=lf
*.conf        text eol=lf

# Windows-only scripts keep CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Binary files — never touch line endings
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.svg         binary
*.jar         binary
*.war         binary
*.class       binary
*.zip         binary
*.tar.gz      binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.eot         binary
